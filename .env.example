PORT=3001
JWT_SECRET=change-me-in-production
ENCRYPTION_KEY=change-me-in-production
DATABASE_URL=./data/ryse.db
CORS_ORIGIN=*
VITE_API_URL=
VITE_WS_URL=
NODE_ENV=development

# OAuth - Shopify
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SCOPES=read_products,read_orders

# OAuth - GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# App URL (base URL for OAuth redirects)
# If not set, the server auto-detects from request headers (x-forwarded-host, host).
# For Railway deployments, RAILWAY_PUBLIC_DOMAIN is also checked automatically.
# Only set this if auto-detection doesn't work for your setup.
APP_URL=
